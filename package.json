{
  "name": "@thinkbuff/figma",
  "version": "0.0.8",
  "private": true,
  "description": "Simplify plugin and widget creation for Figma and FigJam",
  "license": "MIT",
  "author": "Eleven <eteplus@outlook.com>",
  "type": "module",
  "scripts": {
    "clean": "pnpm run -r clean && rm -rf node_modules",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "check": "vp check",
    "typecheck": "pnpm run -r typecheck",
    "build": "pnpm run -r build",
    "test": "pnpm -r test",
    "test:visual": "pnpm -F @thinkbuff/figma-react test:visual",
    "test:visual:update": "pnpm -F @thinkbuff/figma-react test:visual:update",
    "storybook": "pnpm -F @thinkbuff/figma-react storybook",
    "release": "changelogen --release --no-commit --no-tag && tsx scripts/update-version.ts",
    "postinstall": "pnpm -F @thinkbuff/figma-theme build",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "changelogen": "catalog:",
    "glob": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "vp staged",
    "commit-msg": "pnpm commitlint --edit ${1}"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@10.34.7"
}
