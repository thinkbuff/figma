{
  "name": "@thinkbuff/figma-react",
  "version": "0.0.8",
  "description": "A Figma React UI components for creating plugins and widgets",
  "keywords": [
    "figma",
    "figma-plugin",
    "figma-react",
    "react",
    "react-component",
    "unocss",
    "unocss-preset",
    "unocss-preset-figma-theme"
  ],
  "homepage": "https://github.com/thinkbuff/figma/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/thinkbuff/figma/issues"
  },
  "license": "MIT",
  "author": "Eleven <eteplus@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkbuff/figma",
    "directory": "packages/react"
  },
  "files": [
    "*.css",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.mjs"
    },
    "./components": {
      "types": "./dist/components/index.d.mts",
      "import": "./dist/components/index.mjs"
    },
    "./*": {
      "types": "./dist/components/*/index.d.mts",
      "import": "./dist/components/*/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -h 127.0.0.1 -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "pnpm build",
    "test": "vitest run --project browser --project unit",
    "test:visual": "vitest run --project vrt",
    "test:visual:update": "vitest run --project vrt --update"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "catalog:radix",
    "@radix-ui/react-checkbox": "catalog:radix",
    "@radix-ui/react-dialog": "catalog:radix",
    "@radix-ui/react-dropdown-menu": "catalog:radix",
    "@radix-ui/react-label": "catalog:radix",
    "@radix-ui/react-popover": "catalog:radix",
    "@radix-ui/react-radio-group": "catalog:radix",
    "@radix-ui/react-scroll-area": "catalog:radix",
    "@radix-ui/react-select": "catalog:radix",
    "@radix-ui/react-separator": "catalog:radix",
    "@radix-ui/react-slider": "catalog:radix",
    "@radix-ui/react-slot": "catalog:radix",
    "@radix-ui/react-switch": "catalog:radix",
    "@radix-ui/react-tabs": "catalog:radix",
    "@radix-ui/react-toggle": "catalog:radix",
    "@radix-ui/react-toggle-group": "catalog:radix",
    "@radix-ui/react-tooltip": "catalog:radix",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@storybook/addon-docs": "catalog:storybook",
    "@storybook/react-vite": "catalog:storybook",
    "@thinkbuff/figma-theme": "workspace:*",
    "@unocss/preset-rem-to-px": "catalog:unocss",
    "@vitejs/plugin-react": "catalog:react",
    "@vitest/browser-playwright": "catalog:",
    "glob": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "storybook": "catalog:storybook",
    "typescript": "catalog:",
    "unocss": "catalog:unocss",
    "unocss-preset-animations": "catalog:unocss",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "@thinkbuff/figma-theme": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  }
}
