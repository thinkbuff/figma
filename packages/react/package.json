{
  "name": "@thinkbuff/figma-react",
  "version": "0.1.0",
  "description": "A Figma React UI components for creating plugins and widgets",
  "keywords": [
    "figma",
    "figma-plugin",
    "figma-react",
    "react",
    "react-component",
    "tailwindcss",
    "tailwindcss-figma-theme",
    "tailwindcss-theme"
  ],
  "homepage": "https://github.com/thinkbuff/figma/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/thinkbuff/figma/issues"
  },
  "license": "MIT",
  "author": "Eleven <eteplus@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkbuff/figma",
    "directory": "packages/react"
  },
  "files": [
    "*.css",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "import": "./dist/utils/index.mjs"
    },
    "./components": {
      "types": "./dist/components/index.d.mts",
      "import": "./dist/components/index.mjs"
    },
    "./*": {
      "types": "./dist/components/*/index.d.mts",
      "import": "./dist/components/*/index.mjs"
    },
    "./styles.css": "./styles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -h 127.0.0.1 -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "pnpm build",
    "test": "vitest run --project browser --project unit",
    "test:visual": "rm -rf node_modules/.vite && vitest run --project vrt",
    "test:visual:update": "rm -rf node_modules/.vite && vitest run --project vrt --update",
    "probe": "rm -rf node_modules/.vite && vitest run --project probe --reporter=verbose"
  },
  "dependencies": {
    "@base-ui/react": "catalog:react",
    "@emmetio/math-expression": "catalog:runtime",
    "@thinkbuff/figma-theme": "workspace:^",
    "class-variance-authority": "catalog:tailwind",
    "clsx": "catalog:tailwind",
    "sonner": "catalog:react",
    "tailwind-merge": "catalog:tailwind"
  },
  "devDependencies": {
    "@iconify-json/mdi": "catalog:iconify",
    "@iconify-json/tabler": "catalog:iconify",
    "@iconify/tailwind4": "catalog:iconify",
    "@storybook/addon-docs": "catalog:storybook",
    "@storybook/react-vite": "catalog:storybook",
    "@tailwindcss/vite": "catalog:tailwind",
    "@vitejs/plugin-react": "catalog:react",
    "@vitest/browser": "catalog:test",
    "@vitest/browser-playwright": "catalog:test",
    "glob": "catalog:toolchain",
    "playwright": "catalog:test",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "storybook": "catalog:storybook",
    "tailwindcss": "catalog:tailwind",
    "typescript": "catalog:toolchain",
    "vite": "catalog:toolchain",
    "vitest": "catalog:test",
    "vitest-browser-react": "catalog:test"
  },
  "peerDependencies": {
    "@types/react": "*",
    "@types/react-dom": "*",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  }
}
