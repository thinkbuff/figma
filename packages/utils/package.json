{
  "name": "@thinkbuff/figma-utils",
  "author": "Eleven <eteplus@outlook.com>",
  "license": "MIT",
  "type": "module",
  "version": "0.0.8",
  "description": "Utilities for Figma plugin and widget",
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "build": "vp pack",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "homepage": "https://github.com/thinkbuff/figma/tree/main/packages/utils#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkbuff/figma",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://github.com/thinkbuff/figma/issues"
  },
  "keywords": [
    "figma",
    "figma-plugin",
    "figma-utils"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/node/index.d.mts",
      "import": "./dist/node/index.mjs"
    },
    "./image": {
      "types": "./dist/image/index.d.mts",
      "import": "./dist/image/index.mjs"
    },
    "./message-channel": {
      "types": "./dist/message-channel.d.mts",
      "import": "./dist/message-channel.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@figma/plugin-typings": "*",
    "@figma/widget-typings": "*"
  },
  "peerDependenciesMeta": {
    "@figma/plugin-typings": {
      "optional": true
    },
    "@figma/widget-typings": {
      "optional": true
    }
  },
  "dependencies": {
    "eventemitter3": "catalog:",
    "type-fest": "catalog:"
  },
  "devDependencies": {
    "@figma/plugin-typings": "catalog:figma",
    "@figma/widget-typings": "catalog:figma",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
