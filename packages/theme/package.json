{
  "name": "@thinkbuff/figma-theme",
  "version": "0.1.0",
  "description": "Figma theme",
  "keywords": [
    "figma",
    "figma-theme",
    "tailwindcss",
    "tailwindcss-figma-theme",
    "tailwindcss-theme"
  ],
  "homepage": "https://github.com/thinkbuff/figma/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/thinkbuff/figma/issues"
  },
  "license": "MIT",
  "author": "Eleven <eteplus@outlook.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkbuff/figma",
    "directory": "packages/theme"
  },
  "files": [
    "*.css",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./colors": {
      "types": "./dist/colors/index.d.mts",
      "import": "./dist/colors/index.mjs",
      "default": "./dist/colors/index.mjs"
    },
    "./css/*": "./dist/css/*",
    "./*": "./*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "build": "pnpm generate:css && vp pack && cp -r src/css dist/css",
    "generate:css": "tsx src/theme/generate-css-files.ts",
    "typecheck": "tsc --noEmit",
    "release": "changelogen --bump --no-output",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsx": "catalog:cli",
    "typescript": "catalog:toolchain",
    "vite-plus": "catalog:toolchain",
    "vitest": "catalog:test"
  }
}
