{
  "name": "@thinkbuff/figma-theme",
  "author": "Eleven <eteplus@outlook.com>",
  "license": "MIT",
  "type": "module",
  "version": "0.0.8",
  "description": "Figma theme",
  "scripts": {
    "clean": "rm -rf dist node_modules",
    "build": "vp pack && pnpm generate:css",
    "generate:css": "tsx scripts/generate-css-files.ts",
    "typecheck": "tsc --noEmit",
    "release": "changelogen --bump --no-output",
    "prepublishOnly": "pnpm build",
    "test": "vitest run"
  },
  "homepage": "https://github.com/thinkbuff/figma/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinkbuff/figma",
    "directory": "packages/theme"
  },
  "bugs": {
    "url": "https://github.com/thinkbuff/figma/issues"
  },
  "keywords": [
    "figma",
    "figma-theme",
    "unocss",
    "unocss-preset",
    "unocss-preset-figma-theme"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./colors": {
      "types": "./dist/colors/index.d.mts",
      "import": "./dist/colors/index.mjs",
      "default": "./dist/colors/index.mjs"
    },
    "./unocss": {
      "types": "./dist/unocss/index.d.mts",
      "import": "./dist/unocss/index.mjs",
      "default": "./dist/unocss/index.mjs"
    },
    "./css/*": "./dist/css/*",
    "./*": "./*"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "files": [
    "*.css",
    "dist"
  ],
  "devDependencies": {
    "tsx": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:unocss",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
